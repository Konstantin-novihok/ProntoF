# Home Master — единственное пользовательское приложение
HOME_MASTER_PORT=30802
HOME_MASTER_DATA=/mnt/ProntoFix/apps/prontof/home-master-data

# Внутренний worker ProntoF — без опубликованного порта и отдельного интерфейса
PRONTOF_DATA=/mnt/ProntoFix/apps/prontof/home-master-prontof-data
MAX_UPLOAD_GB=500
WHISPER_MODEL=small
CPU_THREADS=2

# Учётная запись владельца Home Master
OWNER_USERNAME=owner
OWNER_PASSWORD=CHANGE_THIS_HOME_MASTER_PASSWORD
ALLOW_REGISTRATION=1

# Внутренний технический владелец worker (пользователь его не использует)
PRONTOF_OWNER_PASSWORD=CHANGE_THIS_INTERNAL_PASSWORD

# Задайте случайные секреты длиной не менее 32 символов.
SECRET_KEY=CHANGE_THIS_HOME_MASTER_SECRET_KEY_32_CHARS_MIN
PRONTOF_SECRET_KEY=CHANGE_THIS_PRONTOF_SECRET_KEY_32_CHARS_MIN
INTERNAL_API_KEY=CHANGE_THIS_SHARED_INTERNAL_API_KEY_64_CHARS

MAP_PROVIDER=osm
TZ=Europe/Kyiv
